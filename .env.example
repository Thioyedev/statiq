# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-project-statiq-data
GCP_REGION=europe-west1

# ── Redis (Cloud Memorystore — use localhost for local dev) ───────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=7200

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
MAX_FILE_SIZE_MB=100

# ── Langfuse (observability — https://cloud.langfuse.com) ────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL

# ── Credentials (local dev only — NEVER commit this file) ────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./credentials/sa-key.json
